# ============================================================================
# CALL-ANALYZER · Environment template
# ----------------------------------------------------------------------------
# Copy to .env and fill in real values. .env is gitignored and must stay that way.
#   cp .env.example .env
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# LOCAL (from `supabase status`) — the defaults below match this repo's
# config.toml, which uses the 544xx port range to coexist with other local
# Supabase projects on the same machine.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# CLOUD (fill these in when deploying; leave blank while developing locally)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── LLM provider ────────────────────────────────────────────────────────────
# The backend is provider-agnostic; LLM_PROVIDER selects the adapter.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Model roles. Kept separate so a slow/expensive model can be used for scoring
# while a cheap one handles routing, without touching code.
GEMINI_SCORING_MODEL=gemini-3.6-flash
GEMINI_SUMMARY_MODEL=gemini-3.6-flash
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Ordered fallback ladder. Gemini's free tier returns HTTP 503 under load, so
# the adapter walks this list before giving up. Comma-separated.
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.7-flash

# Embedding width. MUST stay 768: pgvector's HNSW index cannot exceed 2000
# dimensions, and the vector(768) column type is fixed in migration 0008.
EMBEDDING_DIMENSIONS=768

# ── Pipeline behaviour ──────────────────────────────────────────────────────
# MOCK_LLM=true runs the entire agent pipeline against deterministic canned
# responses: no API calls, no cost, no rate limits, identical output every run.
# Use it for UI development, tests, and live demos.
MOCK_LLM=false

LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=120
LLM_BACKOFF_BASE_SECONDS=2

# Capture full prompt/response bodies into agent_runs. Great for the demo and
# the report; turn off if storage matters.
DEBUG_CAPTURE_IO=true

# Worker
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_JOB_TIMEOUT_MINUTES=15

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
