# ── Secrets ─────────────────────────────────────────────────────────────────
# NEVER commit real keys. .env.example is the tracked template.
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Node / React ────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.vite/
*.local

# ── Supabase local stack ────────────────────────────────────────────────────
supabase/.temp/
supabase/.branches/

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Runtime artefacts ───────────────────────────────────────────────────────
*.log
uploads/
audio_cache/
